---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFile } from 'fs/promises';
import { marked } from 'marked';
import { fileURLToPath } from 'url';
import { join, dirname } from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const contentPath = join(__dirname, '../../content/terms-and-conditions/ja.md');
let content: string;
try {
  content = await readFile(contentPath, 'utf-8');
} catch (e) {
  const projectRoot = join(__dirname, '../../../');
  const fallbackPath = join(projectRoot, 'src/content/terms-and-conditions/ja.md');
  content = await readFile(fallbackPath, 'utf-8');
}
const htmlContent = await marked(content);
---

<BaseLayout title="利用規約" description="Dimewise 利用規約">
  <article class="prose prose-neutral max-w-none">
    <div set:html={htmlContent} />
  </article>
</BaseLayout>

<style is:global>
  .prose {
    color: var(--color-text-primary);
  }
  .prose h1 {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text-primary);
  }
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
  }
  .prose p {
    margin-bottom: 1rem;
    color: var(--color-text-primary);
    line-height: 1.625;
  }
  .prose ul,
  .prose ol {
    margin-bottom: 1rem;
    margin-left: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }
  .prose strong {
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .prose a {
    color: var(--color-primary-600);
  }
  .prose a:hover {
    color: var(--color-primary-700);
    text-decoration: underline;
  }
</style>
