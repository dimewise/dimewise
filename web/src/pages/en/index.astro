---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Dimewise" description="Personal Finance Tracker">
  <div class="text-center py-12">
    <h1 class="text-4xl font-bold mb-4" style="color: var(--color-text-primary);">Dimewise</h1>
    <p class="text-lg mb-8" style="color: var(--color-text-secondary);">Personal Finance Tracker</p>
    <nav class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/en/privacy-policy"
        class="px-6 py-3 bg-neutral-900 text-white rounded-lg hover:bg-neutral-800 transition-colors"
      >
        Privacy Policy
      </a>
      <a
        href="/en/terms-and-conditions"
        class="px-6 py-3 border border-neutral-300 rounded-lg hover:bg-neutral-50 transition-colors"
        style="color: var(--color-text-primary);"
      >
        Terms & Conditions
      </a>
    </nav>
  </div>
</BaseLayout>
