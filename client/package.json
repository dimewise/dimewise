		"babel-plugin-react-compiler": "^1.0.0",
		"globals": "^16.5.0",
		"openapi-format": "^1.29.3",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-pwa": "^1.2.0"
	}
