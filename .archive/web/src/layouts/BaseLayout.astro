---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import '../styles/global.css';
import { getLocaleFromPath } from '../utils/i18n';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentLocale = getLocaleFromPath(Astro.url.pathname);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description || title} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Dimewise</title>
  </head>
  <body class="min-h-screen" style="background-color: var(--color-surface-base);">
    <header class="border-b" style="border-color: var(--color-border);">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center justify-between">
          <a href={`/${currentLocale}/`} class="flex items-center gap-2 no-underline">
            <img src="/logo.svg" alt="Dimewise" class="h-6 w-6" />
            <span class="text-xl font-semibold" style="color: var(--color-text-primary);">Dimewise</span>
          </a>
          <LanguageSwitcher currentLocale={currentLocale} currentPath={currentPath} />
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <footer class="border-t mt-16" style="border-color: var(--color-border);">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm" style="color: var(--color-text-secondary);">
          <p>&copy; {new Date().getFullYear()} Dimewise. All rights reserved.</p>
          <nav class="flex gap-6">
            <a
              href={`/${currentLocale}/privacy-policy`}
              class="transition-colors hover:opacity-80"
              style="color: var(--color-text-secondary);"
            >
              {currentLocale === 'ja' ? 'プライバシーポリシー' : 'Privacy Policy'}
            </a>
            <a
              href={`/${currentLocale}/terms-and-conditions`}
              class="transition-colors hover:opacity-80"
              style="color: var(--color-text-secondary);"
            >
              {currentLocale === 'ja' ? '利用規約' : 'Terms & Conditions'}
            </a>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
